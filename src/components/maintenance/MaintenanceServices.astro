---
import { maintenancePage } from '@/data/maintenance'
---

<section class="maintenance-section maintenance-services" aria-labelledby="maintenance-services-title">
    <div class="maintenance-section__inner">
        <h2 id="maintenance-services-title">我们的服务</h2>
        <div class="maintenance-services__grid">
            {maintenancePage.services.map((service) => (
                <article class="maintenance-service maintenance-glass">
                    <div class="maintenance-service__image">
                        <img src={service.image} alt={service.title} loading="lazy" />
                    </div>
                    <div class="maintenance-service__body">
                        <h3>{service.title}</h3>
                        <p>{service.description}</p>
                    </div>
                </article>
            ))}
        </div>
    </div>
</section>
