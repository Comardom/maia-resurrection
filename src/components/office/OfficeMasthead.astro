---
import { studio } from '@/data/studio.ts';
---

<header class="office-masthead">
    <div class="office-masthead__inner">
        <button class="office-masthead__theme-toggle"
                type="button"
                data-theme-control="toggle"
                aria-label="切换主题">
            <img src="/luna-black.svg" alt="" class="icon icon-luna-black" />
            <img src="/solar-white.svg" alt="" class="icon icon-solar-white" />
        </button>

        <a href="/" class="office-masthead__brand">
            <img src={studio.logo.light} class="logo logo-light" alt={studio.name} />
            <img src={studio.logo.dark} class="logo logo-dark" alt={studio.name} aria-hidden="true" />
            <span class="office-masthead__title">{studio.name}</span>
        </a>

        <div class="application-center">
            <button id="app-menu-toggle" class="app-menu-toggle" aria-label="打开应用中心"
                aria-expanded="false" aria-controls="app-menu">
                <img src="/more-black.svg" class="icon icon-more-black" alt="" />
                <img src="/more-white.svg" class="icon icon-more-white" alt="" />
            </button>

            <div id="app-menu" class="app-menu" role="dialog" aria-modal="true"
                aria-labelledby="app-menu-title" aria-hidden="true" inert>
                <h2 id="app-menu-title" class="sr-only">应用中心</h2>
                <div class="app-menu-tiles">
                    <a href={studio.links.exam} class="tile"><span>考试系统</span></a>
                    <a href={studio.links.erp} class="tile"><span>管理系统</span></a>
                    <a href={studio.links.qq.joinUrl}
                       target="_blank"
                       rel="noopener noreferrer"
                       class="tile tile--qq">
                        <span class="tile--qq__label">QQ迎新群</span>
                        <span class="tile--qq__number">群号：{studio.links.qq.groupNumber}</span>
                    </a>
                </div>
                <button id="app-menu-close" class="app-menu-close" aria-label="关闭应用中心">
                    <img src="/close-black.svg" class="icon icon-close-black" alt="" />
                    <img src="/close-white.svg" class="icon icon-close-white" alt="" />
                </button>
            </div>
            <div id="app-menu-backdrop" class="app-menu-backdrop"></div>
        </div>
    </div>

    <div class="qq-popup" aria-hidden="true">
        <div class="qq-popup__glass">
            <div class="qq-popup__qr-area">
                {
                    Array.from({ length: 5 }).map((_, i) => (
                        <div
                            class="qq-popup__slice"
                            style={`--band-top: ${i * 20}%; --band-bottom: ${100 - (i + 1) * 20}%; background-image: url(${studio.links.qq.qr});`}
                        />
                    ))
                }
            </div>
        </div>
    </div>
</header>

<style>
    .application-center {
        display: flex;
        align-items: center;
    }

    .app-menu-toggle {
        padding: 0;
        font-size: 1rem;
        background: transparent;
        inline-size: 2.5rem;
        block-size: 2.5rem;
        border: 0.15rem solid var(--studio-ring);
        border-radius: 50%;
        cursor: pointer;
        color: inherit;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }

    .app-menu-toggle .icon {
        position: absolute;
        inline-size: 1.4rem;
        block-size: 1.4rem;
        opacity: 0;
        transition: opacity 0.3s;
    }

    .app-menu-toggle .icon-more-black { opacity: 1; }
    :global(.dark) .app-menu-toggle .icon-more-black { opacity: 0; }
    :global(.dark) .app-menu-toggle .icon-more-white { opacity: 1; }

    .app-menu-backdrop {
        position: fixed;
        inset: 0;
        z-index: 1001;
        background: var(--studio-backdrop);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s;
    }

    .app-menu-backdrop.open {
        opacity: 1;
        pointer-events: auto;
    }

    .app-menu {
        position: fixed;
        top: 0;
        inset-inline: 0;
        block-size: 30dvb;
        z-index: 1002;
        background: var(--studio-panel-bg);
        color: var(--studio-panel-color);
        transform: translateY(-100%);
        visibility: hidden;
        pointer-events: none;
        transition: transform 0.3s ease,
                    visibility 0s linear 0.3s;
        display: flex;
    }

    .app-menu-close {
        inline-size: 6.5rem;
        align-self: stretch;
        flex-shrink: 0;
        padding: 0;
        border: none;
        border-inline-start: 1px solid var(--studio-panel-border);
        border-inline-end: 1px solid var(--studio-panel-border);
        background: transparent;
        cursor: pointer;
        position: relative;
        display: grid;
        place-items: center;
    }

    .app-menu-close .icon {
        grid-area: 1 / 1;
        inline-size: 1.4rem;
        block-size: 1.4rem;
        opacity: 0;
        transition: opacity 0.3s;
    }

    .app-menu-close .icon-close-black,
    .app-menu-close .icon-close-white {
        padding: 0.4rem;
        border: 0.15rem solid var(--studio-ring-close);
        border-radius: 50%;
        box-sizing: content-box;
    }

    .app-menu.open {
        transform: translateY(0);
        visibility: visible;
        pointer-events: auto;
        transition: transform 0.3s ease, visibility 0s;
    }

    :global(.dark) .app-menu {
        background: var(--studio-panel-bg);
        color: var(--studio-panel-color);
    }

    .app-menu-close .icon-close-black { opacity: 1; }
    :global(.dark) .app-menu-close .icon-close-black { opacity: 0; }
    :global(.dark) .app-menu-close .icon-close-white { opacity: 1; }

    .app-menu-tiles {
        flex: 1;
        overflow: visible;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(8rem, 1fr));
        gap: 1rem;
        padding: 3rem;
        min-inline-size: 0;
    }

    .tile {
        aspect-ratio: 1;
        background: var(--studio-tile);
        color: var(--studio-tile-color);
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        font-size: 1rem;
        transition: background-color 0.2s;
    }

    .tile:hover { background: var(--studio-tile-hover); }

    .tile--qq {
        position: relative;
        background: linear-gradient(135deg, var(--studio-tile), var(--studio-tile-hover));
        flex-direction: column;
        gap: 0.25rem;
        touch-action: manipulation;
        -webkit-touch-callout: none;
        -webkit-user-select: none;
        user-select: none;
    }

    .tile--qq:hover {
        background: linear-gradient(135deg, var(--studio-tile), var(--studio-tile-hover));
    }

    .tile--qq__label {
        font-size: 1.1rem;
    }

    .tile--qq__number {
        font-size: 0.9rem;
        opacity: 0.85;
    }

    .qq-popup {
        position: fixed;
        inset: 0;
        z-index: 1005;
        display: grid;
        place-items: center;
        pointer-events: none;
        visibility: hidden;
        opacity: 0;
    }

    .qq-popup__glass {
        position: relative;
        display: grid;
        place-items: center;
        inline-size: min(26rem, 62svb);
        block-size: min(26rem, 62svb);
        box-sizing: border-box;
        pointer-events: none;
        background-color: color-mix(in srgb, var(--studio-panel-bg) 50%, transparent);
        background-image: linear-gradient(rgba(255, 255, 255, 0.12), transparent);
        -webkit-backdrop-filter: blur(0.625rem);
        backdrop-filter: blur(0.625rem);
        border: 0.0625rem solid var(--studio-panel-border);
        box-shadow: 0 1rem 2rem rgba(0, 0, 0, 0.3);
    }

    .qq-popup__qr-area {
        position: relative;
        inline-size: 78.62%;
        block-size: 78.62%;
    }

    .qq-popup__slice {
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center;
        clip-path: inset(var(--band-top) 0 var(--band-bottom) 0);
        transform-origin: 50% 50%;
        will-change: transform;
    }

    @media (hover: none) {
        .qq-popup__glass {
            pointer-events: auto;
        }
    }

    @media (hover: hover) {
        .app-menu-toggle:hover,
        .app-menu-close:hover {
            background-color: var(--studio-hover-bg);
        }
    }

    .sr-only {
        position: absolute;
        inline-size: 1px;
        block-size: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    @media (pointer: coarse) {
        .app-menu-toggle {
            inline-size: 2.75rem;
            block-size: 2.75rem;
            border-radius: 50%;
        }
    }

    @media (max-width: 48rem) {
        .app-menu {
            block-size: 75dvb;
        }

        .app-menu-close {
            inline-size: 4rem;
            margin-inline-end: 1.375rem;
        }

        .app-menu-tiles {
            padding: 1rem;
            grid-template-columns: repeat(auto-fill, minmax(6rem, 1fr));
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .app-menu,
        .app-menu-backdrop,
        .app-menu-toggle .icon,
        .app-menu-close .icon {
            transition: none;
        }
    }
</style>

<script>
    import { initAppMenu } from '@/components/office/officeAppMenuScript'
    import { initQqPopupGenie } from '@/utils/qqPopupGenie'
    initAppMenu()
    initQqPopupGenie()
</script>
