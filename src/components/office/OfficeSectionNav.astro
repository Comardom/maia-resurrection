---
import { officePage } from '@/data/office.ts';
---

<nav class="office-section-nav" aria-label="办公室页面导航">
    <div class="office-section-nav__inner">
        <div class="office-section-nav__links">
            {
                officePage.navigation.map((item) => (
                    <>
                        {
                            officePage.navigation.indexOf(item) > 0 && (
                                <span
                                    class="office-section-nav__separator"
                                    data-office-section-separator
                                    data-left-id={officePage.navigation[officePage.navigation.indexOf(item) - 1].id}
                                    data-right-id={item.id}
                                    aria-hidden="true"
                                >
                                    <span class="dot dot--outer"></span>
                                    <span class="dot dot--middle"></span>
                                    <span class="dot dot--inner"></span>
                                </span>
                            )
                        }
                        <a
                            href={`#${item.id}`}
                            class:list={[
                                'office-section-nav__link',
                                { 'is-active': item.id === 'home' },
                            ]}
                            data-office-section-link={item.id}
                            aria-current={item.id === 'home' ? 'page' : undefined}
                        >
                            <span class="office-section-nav__label">{item.label}</span>
                        </a>
                    </>
                ))
            }
        </div>

        <div class="office-theme-controls" aria-label="主题模式">
            <button type="button" class="office-theme-controls__option"
                    data-theme-control="light" aria-pressed="false">
                浅色模式
            </button>
            <span class="office-theme-controls__separator"
                  data-office-theme-separator
                  data-left-theme="light"
                  data-right-theme="dark"
                  aria-hidden="true">
                <span class="dot dot--outer"></span>
                <span class="dot dot--middle"></span>
                <span class="dot dot--inner"></span>
            </span>
            <button type="button" class="office-theme-controls__option"
                    data-theme-control="dark" aria-pressed="false">
                深色模式
            </button>
        </div>
    </div>
</nav>

<style>
    .office-section-nav {
        position: sticky;
        top: 0;
        z-index: 900;
        min-block-size: var(--office-section-nav-height);
        background: var(--office-header-bg);
        color: var(--office-header-color);
        border-block-end: 1px solid var(--office-header-border);
        backdrop-filter: blur(0.75rem);
    }

    .office-section-nav__inner {
        min-block-size: var(--office-section-nav-height);
        max-inline-size: 90rem;
        margin-inline: auto;
        padding-inline: 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
        box-sizing: border-box;
    }

    .office-section-nav__links,
    .office-theme-controls {
        display: flex;
        align-items: center;
    }

    .office-section-nav__links {
        gap: 1rem;
        min-inline-size: 0;
    }

    .office-section-nav__link {
        display: inline-flex;
        align-items: center;
        padding-block: 0.55rem;
        color: var(--office-header-muted);
        font-size: 0.95rem;
        line-height: 1;
        white-space: nowrap;
        transition: color 0.25s ease;
    }

    .office-section-nav__link:hover,
    .office-section-nav__link:focus-visible,
    .office-section-nav__link.is-active {
        color: var(--office-header-active);
    }

    .office-section-nav__label {
        display: inline-block;
    }

    .office-section-nav__separator {
        display: inline-flex;
        align-items: center;
        gap: 0.16rem;
        inline-size: 1.25rem;
        block-size: 0.75rem;
        justify-content: center;
        flex: 0 0 auto;
        overflow: visible;
    }

    .office-section-nav__separator.is-left-active {
        flex-direction: row-reverse;
    }

    .office-section-nav__separator .dot {
        display: block;
        flex: 0 0 auto;
        inline-size: 0.18rem;
        block-size: 0.18rem;
        border-radius: 50%;
        background: var(--office-header-dot);
        opacity: 0.14;
        transition: opacity 0.25s ease;
    }

    .office-section-nav__separator.is-left-active .dot--outer,
    .office-section-nav__separator.is-right-active .dot--outer {
        opacity: 0.22;
    }

    .office-section-nav__separator.is-left-active .dot--middle,
    .office-section-nav__separator.is-right-active .dot--middle {
        opacity: 0.58;
    }

    .office-section-nav__separator.is-left-active .dot--inner,
    .office-section-nav__separator.is-right-active .dot--inner {
        opacity: 1;
    }

    .office-theme-controls {
        flex: 0 0 auto;
        gap: 0.55rem;
    }

    .office-theme-controls__option {
        padding: 0.55rem 0;
        border: 0;
        background: transparent;
        color: var(--office-header-muted);
        cursor: pointer;
        font: inherit;
        font-size: 0.9rem;
        line-height: 1;
        white-space: nowrap;
        transition: color 0.25s ease;
    }

    .office-theme-controls__option:hover,
    .office-theme-controls__option:focus-visible,
    .office-theme-controls__option.is-active {
        color: var(--office-header-active);
    }

    .office-theme-controls__separator {
        display: inline-flex;
        align-items: center;
        gap: 0.16rem;
        block-size: 0.75rem;
        justify-content: center;
        overflow: visible;
    }

    .office-theme-controls__separator.is-left-active {
        flex-direction: row-reverse;
    }

    .office-theme-controls__separator .dot {
        display: block;
        flex: 0 0 auto;
        inline-size: 0.18rem;
        block-size: 0.18rem;
        border-radius: 50%;
        background: var(--office-header-dot);
        opacity: 0.14;
        transition: opacity 0.25s ease;
    }

    .office-theme-controls__separator.is-left-active .dot--outer,
    .office-theme-controls__separator.is-right-active .dot--outer {
        opacity: 0.22;
    }

    .office-theme-controls__separator.is-left-active .dot--middle,
    .office-theme-controls__separator.is-right-active .dot--middle {
        opacity: 0.58;
    }

    .office-theme-controls__separator.is-left-active .dot--inner,
    .office-theme-controls__separator.is-right-active .dot--inner {
        opacity: 1;
    }

    @media (max-width: 48rem) {
        .office-section-nav {
            position: fixed;
            inset-block-start: var(--office-masthead-height);
            inset-inline: 0;
        }

        .office-section-nav__inner {
            min-block-size: var(--office-section-nav-height);
            padding-inline: 0.65rem;
            gap: 0.5rem;
        }

        .office-section-nav__links {
            flex: 1 1 auto;
            gap: 0.3rem;
            min-inline-size: 0;
            overflow: visible;
        }

        .office-section-nav__link {
            gap: 0.2rem;
            padding-block: 0.45rem;
            font-size: 0.7rem;
        }

        .office-section-nav__separator {
            inline-size: 0.7rem;
            block-size: 0.6rem;
            gap: 0.08rem;
            overflow: visible;
        }

        .office-section-nav__separator .dot {
            inline-size: 0.12rem;
            block-size: 0.12rem;
        }

        .office-theme-controls {
            display: none;
        }
    }

    @media (hover: hover) {
        .office-section-nav__link:hover,
        .office-theme-controls__option:hover {
            color: var(--office-header-active);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .office-section-nav__link,
        .office-section-nav__separator .dot,
        .office-theme-controls__option,
        .office-theme-controls__separator .dot {
            transition: none;
        }
    }
</style>

<script>
    import { initSectionNav } from './sectionNavScript'
    initSectionNav()
</script>
