---
import { studio } from "@/data/studio.ts";
const currentYear = new Date().getFullYear();
---

<section class="studio-footer">
    <div class="footer-inner">
        <nav class="footer-links" aria-label="相关链接">
            {
                studio.footerLinks.map((link) => (
                        <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
                ))
            }
        </nav>
        <span class="placeholder-of-epilogue" />
        <p class="footer-copy">
            © 2001-{currentYear} {studio.name} | {studio.nameEn}. All rights reserved.
        </p>
        <p class="footer-made">
            由 <a href="https://github.com/Comardom" target="_blank" rel="noopener noreferrer" title="在新窗口打开">Comardom</a> 制作并维护
        </p>
        <span class="placeholder-of-epilogue" />
        <div class="busuanzi" aria-label="站点访问统计">
            今日总访问量 <span id="busuanzi_today_pv">加载中...</span> 次
            · 今日总访客数 <span id="busuanzi_today_uv">加载中...</span> 人
            · 本站总访问量 <span id="busuanzi_site_pv">加载中...</span> 次
            · 本站总访客数 <span id="busuanzi_site_uv">加载中...</span> 人
        </div>
    </div>
</section>

<script>
    import { initBusuanzi } from './busuanziScript'
    initBusuanzi()
</script>

<style>
    .placeholder-of-epilogue {
        block-size: 1.1125rem;
    }
    .studio-footer {
        position: relative;
        inline-size: 100lvi;
        block-size: 100dvb;
        overflow: hidden;
        background: var(--theme-bg);
    }
    .footer-inner {
        position: absolute;
        inset: 0;
        z-index: 10;
        inline-size: 100%;
        block-size: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-evenly;
        text-align: center;
        box-sizing: border-box;
        padding-block: 30dvb;
        padding-inline: 1rem;
        gap: 0.5rem;
        color: var(--theme-color);
    }
    .footer-links {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-around;
        gap: 0.75rem;
    }
    .footer-links a {
        font-size: 1.3625rem;
        font-family: 'Huiwen-HKHei', -apple-system, BlinkMacSystemFont, "Segoe UI",
        "PingFang SC", "Microsoft YaHei", "Noto Sans CJK SC", sans-serif;
        /*font-family: 'PangMenZhengDao', cursive;*/
    }
    .footer-copy {
        margin: 0;
        font-size: 1.15rem;
        font-family: 'PMingLiU-TW', Georgia, 'Times New Roman', serif;
    }
    .footer-made {
        margin: 0;
        font-size: 0.9rem;
        font-family: 'PMingLiU-TW', Georgia, 'Times New Roman', serif;
        opacity: 0.85;
    }
    .footer-made a {
        color: var(--theme-link);
        text-decoration: none;
    }
    .footer-made a:hover {
        text-decoration: underline;
    }
    .busuanzi {
        margin: 0;
        font-size: 0.75rem;
        font-family: 'PMingLiU-TW', Georgia, 'Times New Roman', serif;
        opacity: 0.625;
    }

    @media (min-width: 48rem) {
        .footer-inner {
            padding-inline: 3rem;
        }
    }

    @media (max-width: 48rem) {
        .footer-inner {
            padding-block: 8svb;
            padding-inline: 12svi;
            justify-content: center;
            writing-mode: vertical-rl;
            text-orientation: mixed;
        }
        .footer-links {
            flex: 0 1 auto;
            justify-content: center;
            gap: 1.5rem;
        }
        .footer-links a,
        .footer-copy,
        .footer-made,
        .busuanzi {
            font-size: 1rem;
            margin: 0;
            white-space: nowrap;
        }
    }</style>
