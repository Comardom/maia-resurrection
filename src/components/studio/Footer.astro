---
import { site } from "@/data/site";
const currentYear = new Date().getFullYear();
---

<section class="studio-footer">
    <div class="footer-inner">
        <nav class="footer-links" aria-label="相关链接">
            {
                site.footerLinks.map((link) => (
                    <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
                ))
            }
        </nav>
        <p class="footer-copy">
            © 2001-{currentYear} {site.name} | {site.nameEn}. All rights reserved.
        </p>
    </div>
</section>

<style>
    .studio-footer {
        position: relative;
        inline-size: 100lvi;
        block-size: 100dvb;
        overflow: hidden;
        background: var(--theme-bg);
    }
    .footer-inner {
        position: absolute;
        inset: 0;
        z-index: 10;
        inline-size: 100%;
        block-size: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-evenly;
        text-align: center;
        box-sizing: border-box;
        padding-block: 30dvb;
        padding-inline: 1rem;
        gap: 0.5rem;
        color: var(--theme-color);
    }
    .footer-links {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-around;
        gap: 0.75rem;
    }
    .footer-links a {
        font-size: 1.25rem;
    }
    .footer-copy {
        margin: 0;
        font-size: 1.05rem;
    }

    @media (min-width: 48rem) {
        .footer-inner {
            padding-inline: 3rem;
        }
    }

    @media (max-width: 48rem) {
        .footer-inner {
            padding-block: 8svb;
            padding-inline: 12svi;
            justify-content: center;
            writing-mode: vertical-rl;
            text-orientation: mixed;
        }
        .footer-links {
            flex: 0 1 auto;
            justify-content: center;
            gap: 1.5rem;
        }
        .footer-links a,
        .footer-copy {
            font-size: 1rem;
            margin: 0;
            white-space: nowrap;
        }
    }</style>
