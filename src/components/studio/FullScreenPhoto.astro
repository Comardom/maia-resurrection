---
import { site } from "@/data/site";
---

<section class="fullscreen-photo">
    <img class="photo photo-light" src={site.hero.light.src} alt="" loading="eager" />
    <img class="photo photo-dark"  src={site.hero.dark.src}  alt="" loading="eager" />
    <div class="content">
        <h1>{site.name}</h1>
        <span id="placeholder-of-prologue" />
        <div class="poem">
            <p class="text text-light">{site.hero.light.text}</p>
            <p class="text text-dark">{site.hero.dark.text}</p>
        </div>
    </div>
</section>

<style>
    .fullscreen-photo {
        position: relative;
        inline-size: 100lvi;
        block-size: 100dvb;
        overflow: hidden;
    }
    .photo {
        position: absolute;
        inset: 0;
        inline-size: 100%;
        block-size: 100%;
        object-fit: cover;
        object-position: center;
        display: block;
        opacity: 0.2;
        filter: brightness(0.3);
        transition: opacity 0.3s;
    }
    /* 亮色：显示浅色照片 */
    .photo-light { opacity: 0.2; }
    .photo-dark  { opacity: 0; }
    :global(.dark) .photo-light { opacity: 0; }
    :global(.dark) .photo-dark  { opacity: 0.2; }

    .content {
        position: absolute;
        inset: 0;
        z-index: 10;
        inline-size: 100%;
        block-size: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1rem;
    }
    .content h1 {
        font-size: 2.125rem;
        font-family: 'PMingLiU-TW', Georgia, 'Times New Roman', serif;
        margin: 0;
    }
    .content p {
        font-size: 1.25rem;
        font-family: 'PMingLiU-TW', Georgia, 'Times New Roman', serif;
        text-align: center;
        margin: 0;
        padding-inline: 2rem;
        transition: opacity 0.3s;
    }
    /* 两段文案用 grid 重叠在同一格：占位一致，深浅色间隙完全相同 */
    .poem {
        display: grid;
    }
    .poem p {
        grid-area: 1 / 1;
    }
    .text-light { opacity: 1; }
    .text-dark  { opacity: 0; }
    :global(.dark) .text-light { opacity: 0; }
    :global(.dark) .text-dark  { opacity: 1; }
</style>
