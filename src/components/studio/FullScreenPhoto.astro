---
import { site } from "@/data/site";
---

<section class="fullscreen-photo">
    <img class="photo photo-light" src={site.hero.light.src} alt="" loading="lazy" />
    <img class="photo photo-dark"  src={site.hero.dark.src}  alt="" loading="lazy" />
    <div class="content">
        <h1>{site.name}</h1>
        <p class="text text-light">{site.hero.light.text}</p>
        <p class="text text-dark">{site.hero.dark.text}</p>
    </div>
</section>

<style>
    .fullscreen-photo {
        position: relative;
        inline-size: 100lvi;
        block-size: 100dvb;
        overflow: hidden;
    }
    .photo {
        position: absolute;
        inset: 0;
        inline-size: 100%;
        block-size: 100%;
        object-fit: cover;
        object-position: center;
        display: block;
        opacity: 0.2;
        filter: brightness(0.3);
        transition: opacity 0.3s;
    }
    /* 亮色：显示浅色照片 */
    .photo-light { opacity: 0.2; }
    .photo-dark  { opacity: 0; }
    :global(.dark) .photo-light { opacity: 0; }
    :global(.dark) .photo-dark  { opacity: 0.2; }

    .content {
        position: absolute;
        inset: 0;
        z-index: 10;
        inline-size: 100%;
        block-size: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }
    .content h1 {
        font-size: 2rem;
        font-family: Georgia, 'Times New Roman', serif;
        margin: 0;
    }
    .content p {
        font-size: 1.125rem;
        font-family: Georgia, 'Times New Roman', serif;
        text-align: center;
        padding: 2rem;
        margin: 0;
        transition: opacity 0.3s;
    }
    /* 亮色：显示浅色文案 */
    .text-light { opacity: 1; }
    .text-dark  { opacity: 0; position: absolute; }
    :global(.dark) .text-light { opacity: 0; }
    :global(.dark) .text-dark  { opacity: 1; }
</style>
