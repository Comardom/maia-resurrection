---

---
<header>
    <div class="top-bar">
        <div class="left-group">
            <button id="theme-toggle" class="theme-toggle" aria-label="切换主题">
                <img src="/luna-black.svg"  class="icon icon-luna-black"  alt="" />
                <img src="/solar-white.svg" class="icon icon-solar-white" alt="" />
            </button>
        </div>
        <div class="center-group">
            <a href="/" class="logo-wrapper">
                <img src="/wswd-black.svg" class="logo logo-light" alt="河南大学网站工作室" />
                <img src="/wswd-white.svg" class="logo logo-dark" alt="河南大学网站工作室" />
            </a>
            <span class="title-text">河南大学网站工作室</span>
        </div>
        <div class="right-group">
            <button id="app-menu-toggle" class="app-menu-toggle" aria-label="打开应用中心"
                aria-expanded="false" aria-controls="app-menu">
                <img src="/more-black.svg" class="icon icon-more-black" alt="" />
                <img src="/more-white.svg" class="icon icon-more-white" alt="" />
            </button>
        </div>
    </div>

    <div id="app-menu" class="app-menu" role="dialog" aria-modal="true"
        aria-labelledby="app-menu-title" aria-hidden="true" inert>
        <h2 id="app-menu-title" class="sr-only">应用中心</h2>
        <div class="app-menu-tiles">
            <a href="/nihilum" class="tile"><span>论坛</span></a>
            <a href="https://exam.xn--2qqp2vw2b55cnt3a7mt1eh.cn/" class="tile"><span>考试系统</span></a>
        </div>
        <button id="app-menu-close" class="app-menu-close" aria-label="关闭应用中心">
            <img src="/close-black.svg" class="icon icon-close-black" alt="" />
            <img src="/close-white.svg" class="icon icon-close-white" alt="" />
        </button>
    </div>
    <div id="app-menu-backdrop" class="app-menu-backdrop"></div>
</header>
<style>
    .top-bar {
        position: fixed;
        top: 0; left: 0;
        inline-size: 100lvi;
        min-block-size: 7svb;
        padding-inline: 2rem;
        z-index: 1000;
        display: flex;
        align-items: center;
        gap: 1rem;
        transition: background-color 0.3s, color 0.3s;
        border-bottom: 1px solid rgba(20, 20, 20, 0.2);
        transform-origin: top center;
        animation: breathe-y 6s ease-in-out infinite;
    }

    /* 亮色 */
    .top-bar {
        background: #f5f5f5;
        color: #333;
    }

    /* 深色 — 通过 :global(.dark) 监听 html 的 class */
    :global(.dark) .top-bar {
        background: #2c2c2c;
        color: #f0f0f0;
    }

    .logo-wrapper {
        position: relative;
        display: flex;
    }
    .logo {
        height: 3rem;
        width: auto;
        transition: opacity 0.3s;
    }
    .logo-light { opacity: 1; }       /* 亮色显示 */
    .logo-dark  { opacity: 0; position: absolute; }  /* 叠在下面 */

    :global(.dark) .logo-light { opacity: 0; }
    :global(.dark) .logo-dark  { opacity: 1; }


    .left-group,.center-group,.right-group{
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
    }
    /* 内部元素：等比缩放，从边缘向中心 */
    .left-group {
        transform-origin: left center;
        animation: breathe-xy 6s ease-in-out infinite;
    }
    .center-group {
        transform-origin: center;
        animation: breathe-xy 6s ease-in-out infinite;
    }
    .right-group {
        transform-origin: right center;
        animation: breathe-xy 6s ease-in-out infinite;
    }

    /* 桌面端：logo 排最左，按钮组推向右端 */
    .center-group { order: -1; }
    .left-group   { order: 2; margin-inline-start: auto; }
    .right-group  { order: 3; }

    @keyframes breathe-y {
        0%, 100% { transform: scaleY(1); }
        50%      { transform: scaleY(1.03); }
    }

    @keyframes breathe-xy {
        0%, 100% { transform: scale(1); }
        50%      { transform: scale(1.03); }
    }

    .title-text {
        font-weight: 350;
        font-size: 1.2rem;
        letter-spacing: 0.125rem;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", "Noto Sans CJK SC", sans-serif;
    }


    .theme-toggle {
        padding: 0;
        font-size: 1rem;
        background: transparent;
        inline-size: 2.5rem;
        block-size: 2.5rem;
        border: 0.15rem solid #bebebe;
        border-radius: 50%;
        cursor: pointer;
        color: inherit;
        transition: background-color 0.3s;
        display: flex;
        align-items: center;
        justify-content: center;

        position: relative;
    }
    .theme-toggle .icon {
        position: absolute;
        inline-size: 1.4rem;
        block-size: 1.4rem;
        opacity: 0;
        /*transition: opacity 0.3s;*/
        transform: scale(0.5) rotate(-40deg);   /* 初始：缩小+歪 */
        transition: opacity 0.35s ease, transform 0.35s ease;
    }

    .theme-toggle .icon-luna-black { opacity: 1; transform: scale(1) rotate(0); }
    :global(.dark) .theme-toggle .icon-luna-black { opacity: 0; transform: scale(0.5) rotate(60deg); }
    :global(.dark) .theme-toggle .icon-solar-white { opacity: 1; transform: scale(1) rotate(0); }

    /* !* 浅色：显示黑月亮 *!
     .theme-toggle .icon-luna-black { opacity: 1; }
     !* 深色：显示白太阳 *!
     :global(.dark) .theme-toggle .icon-luna-black  { opacity: 0; }
     :global(.dark) .theme-toggle .icon-solar-white { opacity: 1; }*/

    @media (hover: hover) {
        .theme-toggle:hover,
        .app-menu-toggle:hover,
        .app-menu-close:hover {
            background-color: rgba(128, 128, 128, 0.15);
        }
    }


    .app-menu-toggle {
        padding: 0;
        font-size: 1rem;
        background: transparent;
        inline-size: 2.5rem;
        block-size: 2.5rem;
        border: 0.15rem solid #bebebe;
        border-radius: 50%;
        cursor: pointer;
        color: inherit;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }
    .app-menu-toggle .icon {
        position: absolute;
        inline-size: 1.4rem;
        block-size: 1.4rem;
        opacity: 0;
        transition: opacity 0.3s;
    }
    .app-menu-toggle .icon-more-black { opacity: 1; }
    :global(.dark) .app-menu-toggle .icon-more-black { opacity: 0; }
    :global(.dark) .app-menu-toggle .icon-more-white { opacity: 1; }

    /* 遮挡层 */
    .app-menu-backdrop {
        position: fixed;
        inset: 0;
        z-index: 1001;
        background: rgba(0, 0, 0, 0.4);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s;
    }
    .app-menu-backdrop.open { opacity: 1; pointer-events: auto; }

    /* 弹窗：顶部滑下，盖住顶栏 */
    .app-menu {
        position: fixed;
        top: 0;
        inset-inline: 0;
        block-size: 30dvb;
        z-index: 1002;
        background: #fff;
        color: #333;
        transform: translateY(-100%);
        transition: transform 0.3s ease;
        display: flex;                 /* 新增：行布局 */
        /* 移除 overflow-y: auto（改由磁贴区自己滚动） */
    }

    /* 关闭竖条 */
    .app-menu-close {
        inline-size: 6.5rem;             /* 竖条宽度（可调） */
        align-self: stretch;           /* 撑满整个高度 */
        flex-shrink: 0;
        padding: 0;
        border: none;
        border-inline-start: 1px solid rgba(20, 20, 20, 0.2);   /* 左侧分隔线 */
        border-inline-end: 1px solid rgba(20, 20, 20, 0.2);     /* 右端分隔线 */
        background: transparent;
        cursor: pointer;
        position: relative;
        display: grid;                 /* 用 grid 让两个图标叠在同一格 */
        place-items: center;
    }

    /* 图标：不再用 absolute，改用 grid 堆叠 */
    .app-menu-close .icon {
        grid-area: 1 / 1;              /* 两个图标重叠在同一单元格 */
        inline-size: 1.4rem;
        block-size: 1.4rem;
        opacity: 0;
        transition: opacity 0.3s;
    }
    /* 关闭按钮的圆形边框（与 2.5rem 圆形按钮视觉一致） */
    .app-menu-close .icon-close-black,
    .app-menu-close .icon-close-white {
        padding: 0.4rem;
        border: 0.15rem solid #bebebe;
        border-radius: 50%;
        box-sizing: content-box;
    }
    :global(.dark) .app-menu-close .icon-close-black,
    :global(.dark) .app-menu-close .icon-close-white {
        border-color: #8a8a8a;
    }
    .app-menu.open { transform: translateY(0); }
    :global(.dark) .app-menu { background: #2c2c2c; color: #f0f0f0; }
    .app-menu-close .icon-close-black { opacity: 1; }
    :global(.dark) .app-menu-close .icon-close-black { opacity: 0; }
    :global(.dark) .app-menu-close .icon-close-white { opacity: 1; }
    :global(.dark) .app-menu-close {
        border-inline-start-color: rgba(255, 255, 255, 0.2);
        border-inline-end-color: rgba(255, 255, 255, 0.2);
    }




    /* Metro 磁贴 */
    /* 磁贴区：占剩余宽度，内部滚动 */
    .app-menu-tiles {
        flex: 1;
        overflow-y: auto;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(6rem, 1fr));
        gap: 1rem;
        padding: 3rem;
        min-inline-size: 0;
    }

    .tile {
        aspect-ratio: 1;
        background: #007ACC;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        font-size: 1rem;
        transition: background-color 0.2s;
    }
    .tile:hover { background: #0a8ad6; }

    /* 屏幕阅读器专用隐藏标题 */
    .sr-only {
        position: absolute;
        inline-size: 1px;
        block-size: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    /* 触控设备：按钮放大到 WCAG 44px 目标，保持正圆 */
    @media (pointer: coarse) {
        .theme-toggle,
        .app-menu-toggle {
            inline-size: 2.75rem;
            block-size: 2.75rem;
            border-radius: 50%;
        }
    }

    /* 移动端：grid 三栏，logo 居中 */
    @media (max-width: 48rem) {
        .top-bar {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            gap: 0;
        }
        .left-group   { grid-column: 1; justify-self: start;  order: 0; margin-inline-start: 0; }
        .center-group { grid-column: 2; justify-self: center; order: 0; }
        .right-group  { grid-column: 3; justify-self: end;    order: 0; }
        .title-text { display: none; }

        /* 弹窗适配 */
        .app-menu {
            block-size: 22dvb;
        }
        .app-menu-close {
            inline-size: 4rem;
            margin-inline-end: 1.375rem;
        }
        .app-menu-tiles {
            padding: 1rem;
            grid-template-columns: repeat(auto-fill, minmax(4.5rem, 1fr));
        }
    }

    /* 减少动态效果偏好 */
    @media (prefers-reduced-motion: reduce) {
        .app-menu,
        .app-menu-backdrop {
            transition: none;
        }
    }
</style>
<script>
    import { initThemeToggle, initAppMenu } from './headerScript'
    initThemeToggle()
    initAppMenu()
</script>