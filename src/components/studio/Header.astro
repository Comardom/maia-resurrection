---
import { studio } from "@/data/studio.ts";
---

<header>
    <div class="top-bar">
        <div class="left-group">
            <button id="theme-toggle" class="theme-toggle" aria-label="切换主题">
                <img src="/luna-black.svg"  class="icon icon-luna-black"  alt="" />
                <img src="/solar-white.svg" class="icon icon-solar-white" alt="" />
            </button>
        </div>
        <div class="center-group">
            <a href="/" class="logo-wrapper">
                <img src={studio.logo.light} class="logo logo-light" alt={studio.name} />
                <img src={studio.logo.dark} class="logo logo-dark" alt={studio.name} aria-hidden="true" />
            </a>
            <span class="title-text">{studio.name}</span>
        </div>
        <div class="right-group">
            <button id="app-menu-toggle" class="app-menu-toggle" aria-label="打开应用中心"
                aria-expanded="false" aria-controls="app-menu">
                <img src="/more-black.svg" class="icon icon-more-black" alt="" />
                <img src="/more-white.svg" class="icon icon-more-white" alt="" />
            </button>
        </div>
    </div>

    <div id="app-menu" class="app-menu" role="dialog" aria-modal="true"
        aria-labelledby="app-menu-title" aria-hidden="true" inert>
        <h2 id="app-menu-title" class="sr-only">应用中心</h2>
        <div class="app-menu-tiles">
            <a href={studio.links.exam} class="tile"><span>考试系统</span></a>
            <a href={studio.links.erp} class="tile"><span>管理系统</span></a>
            <a href={studio.links.qq.joinUrl}
               target="_blank"
               rel="noopener noreferrer"
               class="tile tile--qq">
                <span class="tile--qq__label">QQ迎新群</span>
                <span class="tile--qq__number">群号：{studio.links.qq.groupNumber}</span>
            </a>
        </div>
        <button id="app-menu-close" class="app-menu-close" aria-label="关闭应用中心">
            <img src="/close-black.svg" class="icon icon-close-black" alt="" />
            <img src="/close-white.svg" class="icon icon-close-white" alt="" />
        </button>
    </div>
    <div id="app-menu-backdrop" class="app-menu-backdrop"></div>

    <div class="qq-popup" aria-hidden="true">
        <div class="qq-popup__glass">
            <div class="qq-popup__qr-area">
                {
                    Array.from({ length: 5 }).map((_, i) => (
                        <div
                            class="qq-popup__slice"
                            style={`--band-top: ${i * 20}%; --band-bottom: ${100 - (i + 1) * 20}%; background-image: url(${studio.links.qq.qr});`}
                        />
                    ))
                }
            </div>
        </div>
    </div>
</header>
<style>
    header {
        position: relative;
        z-index: 1000;
    }

    .top-bar {
        position: fixed;
        top: 0; left: 0;
        inline-size: 100lvi;
        min-block-size: 7svb;
        padding-inline: 2rem;
        z-index: 1000;
        display: flex;
        align-items: center;
        gap: 1rem;
        transition: background-color 0.3s, color 0.3s;
        border-bottom: 1px solid var(--studio-topbar-border);
        transform-origin: top center;
        animation: breathe-y 6s ease-in-out infinite;
    }

    /* 游戏模式：停掉呼吸动画（位移由 gsap 控制，带平滑过渡） */
    :global(.game-mode) .top-bar {
        animation: none;
    }

    /* 亮色 */
    .top-bar {
        background: var(--studio-topbar-bg);
        color: var(--studio-topbar-color);
    }

    /* 深色 — 通过 :global(.dark) 监听 html 的 class */
    :global(.dark) .top-bar {
        background: var(--studio-topbar-bg);
        color: var(--studio-topbar-color);
    }

    .logo-wrapper {
        position: relative;
        display: flex;
    }
    .logo {
        height: 3rem;
        width: auto;
        transition: opacity 0.3s;
    }
    .logo-light { opacity: 1; }       /* 亮色显示 */
    .logo-dark  { opacity: 0; position: absolute; }  /* 叠在下面 */

    :global(.dark) .logo-light { opacity: 0; }
    :global(.dark) .logo-dark  { opacity: 1; }


    .left-group,.center-group,.right-group{
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
    }
    /* 内部元素：等比缩放，从边缘向中心 */
    .left-group {
        transform-origin: left center;
        animation: breathe-xy 6s ease-in-out infinite;
    }
    .center-group {
        transform-origin: center;
        animation: breathe-xy 6s ease-in-out infinite;
    }
    .right-group {
        transform-origin: right center;
        animation: breathe-xy 6s ease-in-out infinite;
    }

    /* 桌面端：logo 排最左，按钮组推向右端 */
    .center-group { order: -1; }
    .left-group   { order: 2; margin-inline-start: auto; }
    .right-group  { order: 3; }

    @keyframes breathe-y {
        0%, 100% { transform: scaleY(1); }
        50%      { transform: scaleY(1.03); }
    }

    @keyframes breathe-xy {
        0%, 100% { transform: scale(1); }
        50%      { transform: scale(1.03); }
    }

    .title-text {
        font-weight: 300;
        font-size: 1.3rem;
        /*letter-spacing: 0.0125rem;*/
        font-family: 'Huiwen-HKHei', -apple-system, BlinkMacSystemFont, "Segoe UI",
        "PingFang SC", "Microsoft YaHei", "Noto Sans CJK SC", sans-serif;
        /*font-family: 'PMingLiU-TW', Georgia, 'Times New Roman', serif;*/
        /*font-family: 'PangMenZhengDao', cursive;*/
    }


    .theme-toggle {
        padding: 0;
        font-size: 1rem;
        background: transparent;
        inline-size: 2.5rem;
        block-size: 2.5rem;
        border: 0.15rem solid var(--studio-ring);
        border-radius: 50%;
        cursor: pointer;
        color: inherit;
        transition: background-color 0.3s;
        display: flex;
        align-items: center;
        justify-content: center;

        position: relative;
    }
    .theme-toggle .icon {
        position: absolute;
        inline-size: 1.4rem;
        block-size: 1.4rem;
        opacity: 0;
        /*transition: opacity 0.3s;*/
        transform: scale(0.5) rotate(-60deg);   /* 初始：缩小+歪 */
        transition: opacity 0.35s ease, transform 0.35s ease;
    }

    .theme-toggle .icon-luna-black { opacity: 1; transform: scale(1) rotate(0); }
    :global(.dark) .theme-toggle .icon-luna-black { opacity: 0; transform: scale(0.5) rotate(60deg); }
    :global(.dark) .theme-toggle .icon-solar-white { opacity: 1; transform: scale(1) rotate(0); }

    /* !* 浅色：显示黑月亮 *!
     .theme-toggle .icon-luna-black { opacity: 1; }
     !* 深色：显示白太阳 *!
     :global(.dark) .theme-toggle .icon-luna-black  { opacity: 0; }
     :global(.dark) .theme-toggle .icon-solar-white { opacity: 1; }*/

    @media (hover: hover) {
        .theme-toggle:hover,
        .app-menu-toggle:hover,
        .app-menu-close:hover {
            background-color: var(--studio-hover-bg);
        }
    }


    .app-menu-toggle {
        padding: 0;
        font-size: 1rem;
        background: transparent;
        inline-size: 2.5rem;
        block-size: 2.5rem;
        border: 0.15rem solid var(--studio-ring);
        border-radius: 50%;
        cursor: pointer;
        color: inherit;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }
    .app-menu-toggle .icon {
        position: absolute;
        inline-size: 1.4rem;
        block-size: 1.4rem;
        opacity: 0;
        transition: opacity 0.3s;
    }
    .app-menu-toggle .icon-more-black { opacity: 1; }
    :global(.dark) .app-menu-toggle .icon-more-black { opacity: 0; }
    :global(.dark) .app-menu-toggle .icon-more-white { opacity: 1; }

    /* 遮挡层 */
    .app-menu-backdrop {
        position: fixed;
        inset: 0;
        z-index: 1001;
        background: var(--studio-backdrop);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s;
    }
    .app-menu-backdrop.open { opacity: 1; pointer-events: auto; }

    /* 弹窗：顶部滑下，盖住顶栏 */
    .app-menu {
        position: fixed;
        top: 0;
        inset-inline: 0;
        block-size: 30dvb;
        z-index: 1002;
        background: var(--studio-panel-bg);
        color: var(--studio-panel-color);
        transform: translateY(-100%);
        visibility: hidden;            /* 关闭态彻底不渲染，防缩放穿帮 */
        pointer-events: none;          /* 关闭态防误触 */
        transition: transform 0.3s ease,
                    visibility 0s linear 0.3s;  /* 滑出结束后再隐藏 */
        display: flex;                 /* 新增：行布局 */
        /* 移除 overflow-y: auto（改由磁贴区自己滚动） */
    }

    /* 关闭竖条 */
    .app-menu-close {
        inline-size: 6.5rem;             /* 竖条宽度（可调） */
        align-self: stretch;           /* 撑满整个高度 */
        flex-shrink: 0;
        padding: 0;
        border: none;
        border-inline-start: 1px solid var(--studio-panel-border);   /* 左侧分隔线 */
        border-inline-end: 1px solid var(--studio-panel-border);     /* 右端分隔线 */
        background: transparent;
        cursor: pointer;
        position: relative;
        display: grid;                 /* 用 grid 让两个图标叠在同一格 */
        place-items: center;
    }

    /* 图标：不再用 absolute，改用 grid 堆叠 */
    .app-menu-close .icon {
        grid-area: 1 / 1;              /* 两个图标重叠在同一单元格 */
        inline-size: 1.4rem;
        block-size: 1.4rem;
        opacity: 0;
        transition: opacity 0.3s;
    }
    /* 关闭按钮的圆形边框（与 2.5rem 圆形按钮视觉一致） */
    .app-menu-close .icon-close-black,
    .app-menu-close .icon-close-white {
        padding: 0.4rem;
        border: 0.15rem solid var(--studio-ring-close);
        border-radius: 50%;
        box-sizing: content-box;
    }
    :global(.dark) .app-menu-close .icon-close-black,
    :global(.dark) .app-menu-close .icon-close-white {
        border-color: var(--studio-ring-close);
    }
    .app-menu.open {
        transform: translateY(0);
        visibility: visible;           /* 立即显示，再执行滑动 */
        pointer-events: auto;
        transition: transform 0.3s ease,
                    visibility 0s;
    }
    :global(.dark) .app-menu { background: var(--studio-panel-bg); color: var(--studio-panel-color); }
    .app-menu-close .icon-close-black { opacity: 1; }
    :global(.dark) .app-menu-close .icon-close-black { opacity: 0; }
    :global(.dark) .app-menu-close .icon-close-white { opacity: 1; }
    :global(.dark) .app-menu-close {
        border-inline-start-color: var(--studio-panel-border);
        border-inline-end-color: var(--studio-panel-border);
    }




    /* Metro 磁贴 */
    /* 磁贴区：占剩余宽度，内部滚动 */
    .app-menu-tiles {
        flex: 1;
        overflow: visible;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(8rem, 1fr));
        gap: 1rem;
        padding: 3rem;
        min-inline-size: 0;
    }

    .tile {
        aspect-ratio: 1;
        background: var(--studio-tile);
        color: var(--studio-tile-color);
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        font-size: 1rem;
        transition: background-color 0.2s;
    }
    .tile:hover { background: var(--studio-tile-hover); }

    .tile--qq {
        position: relative;
        background: linear-gradient(135deg, var(--studio-tile), var(--studio-tile-hover));
        flex-direction: column;
        gap: 0.25rem;
        touch-action: manipulation;
        -webkit-touch-callout: none;
        -webkit-user-select: none;
        user-select: none;
    }

    .tile--qq:hover {
        background: linear-gradient(135deg, var(--studio-tile), var(--studio-tile-hover));
    }

    .tile--qq__label {
        font-size: 1.1rem;
    }

    .tile--qq__number {
        font-size: 0.9rem;
        opacity: 0.85;
    }

    .qq-popup {
        position: fixed;
        inset: 0;
        z-index: 1005;
        display: grid;
        place-items: center;
        pointer-events: none;
        visibility: hidden;
        opacity: 0;
    }

    .qq-popup__glass {
        position: relative;
        display: grid;
        place-items: center;
        inline-size: min(26rem, 62svb);
        block-size: min(26rem, 62svb);
        box-sizing: border-box;
        pointer-events: none;
        background-color: color-mix(in srgb, var(--studio-panel-bg) 50%, transparent);
        background-image: linear-gradient(rgba(255, 255, 255, 0.12), transparent);
        -webkit-backdrop-filter: blur(0.625rem);
        backdrop-filter: blur(0.625rem);
        border: 0.0625rem solid var(--studio-panel-border);
        box-shadow: 0 1rem 2rem rgba(0, 0, 0, 0.3);
    }

    .qq-popup__qr-area {
        position: relative;
        inline-size: 78.62%;
        block-size: 78.62%;
    }

    .qq-popup__slice {
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center;
        clip-path: inset(var(--band-top) 0 var(--band-bottom) 0);
        transform-origin: 50% 50%;
        will-change: transform;
    }

    @media (hover: none) {
        .qq-popup__glass {
            pointer-events: auto;
        }
    }

    /* 屏幕阅读器专用隐藏标题 */
    .sr-only {
        position: absolute;
        inline-size: 1px;
        block-size: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    /* 触控设备：按钮放大到 WCAG 44px 目标，保持正圆 */
    @media (pointer: coarse) {
        .theme-toggle,
        .app-menu-toggle {
            inline-size: 2.75rem;
            block-size: 2.75rem;
            border-radius: 50%;
        }
    }

    /* 移动端：grid 三栏，logo 居中 */
    @media (max-width: 48rem) {
        .top-bar {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            gap: 0;
        }
        .left-group   { grid-column: 1; justify-self: start;  order: 0; margin-inline-start: 0; }
        .center-group { grid-column: 2; justify-self: center; order: 0; }
        .right-group  { grid-column: 3; justify-self: end;    order: 0; }
        .title-text { display: none; }

        /* 弹窗适配 */
        .app-menu {
            block-size: 75dvb;
        }
        .app-menu-close {
            inline-size: 4rem;
            margin-inline-end: 1.375rem;
        }
        .app-menu-tiles {
            padding: 1rem;
            grid-template-columns: repeat(auto-fill, minmax(6rem, 1fr));
        }
    }

    /* 减少动态效果偏好 */
    @media (prefers-reduced-motion: reduce) {
        .app-menu,
        .app-menu-backdrop,
        .theme-toggle .icon,
        .app-menu-toggle .icon,
        .logo,
        .top-bar,
        .left-group,
        .center-group,
        .right-group,
        .app-menu-close .icon {
            transition: none;
        }
        .top-bar,
        .left-group,
        .center-group,
        .right-group {
            animation: none;
        }
    }
</style>
<script>
    import { initThemeToggle, initAppMenu } from './headerScript'
    import { initQqPopupGenie } from '@/utils/qqPopupGenie'
    initThemeToggle()
    initAppMenu()
    initQqPopupGenie()
</script>
