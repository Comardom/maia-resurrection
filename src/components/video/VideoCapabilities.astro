---
import { videoPage } from '@/data/video'
---

<section class="video-section video-capabilities" aria-labelledby="capabilities-title">
    <div class="video-section__content">
        <div class="video-section__heading">
            <h2 id="capabilities-title">{videoPage.capabilities.title}</h2>
            <p>以影像记录校园，以专业完成表达。</p>
        </div>
        <div class="capability-grid">
            {videoPage.capabilities.items.map((item) => (
                <article class="capability-card">
                    <h3>{item.title}</h3>
                    <p>{item.description}</p>
                    {item.scope && <small>{item.scope}</small>}
                </article>
            ))}
        </div>
    </div>
</section>
