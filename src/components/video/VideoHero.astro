---
import { videoPage } from '@/data/video'
---

<section id="hero" class="hero" aria-labelledby="video-title">
    <div class="hero-video-elements" aria-hidden="true">
        <span class="hero-video-element hero-video-frame-left"></span>
        <span class="hero-video-element hero-video-frame-right"></span>
        <span class="hero-video-element hero-camera-icon"></span>
    </div>
    <div class="content hero-content">
        <div class="hero-text-container">
            <div class="hero-text-back">
                <h1 id="video-title" class="main-title">{videoPage.hero.title}</h1>
                <div class="subtitle">{videoPage.hero.slogan}</div>
                <p class="intro">{videoPage.hero.introduction}</p>
            </div>
        </div>
    </div>
</section>
