---
import { studio } from "@/data/studio.ts";
const themeCookie = Astro.cookies.get('theme');
const isDark = themeCookie?.value === 'dark';
const title = Astro.props.title ?? studio.title;
const description = Astro.props.description ?? studio.description;

import '/src/css/reset.css'
import '/src/css/theme.css'
import '/src/css/base.css'
import '/src/css/fonts.css'
---

<html lang="zh-CN" class={isDark ? 'dark' : ''}>
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url} />
    <!-- favicon 跟随系统深浅色 -->
    <link rel="icon" type="image/svg+xml"
          media="(prefers-color-scheme: dark)"
          href={studio.logo.dark} id="favicon" />
    <link rel="icon" type="image/svg+xml"
          media="(prefers-color-scheme: light)"
          href={studio.logo.light} />
    <script is:inline set:html={`
        ;(function () {
            const mq = window.matchMedia('(prefers-color-scheme: dark)')
            const favicon = document.getElementById('favicon')
            if (!favicon) return
            const dark = '${studio.logo.dark}'
            const light = '${studio.logo.light}'
            favicon.href = mq.matches ? dark : light
            mq.addEventListener('change', (e) => {
                favicon.href = e.matches ? dark : light
            })
        })()
    `} />

    <!-- OG -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={studio.name} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={studio.url + studio.logo.og} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- JSON-LD -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": studio.name,
        "url": studio.url,
        "logo": studio.url + studio.logo.og,
        "sameAs": studio.social,
    })} />

    <slot name="head" />
</head>
<body>
<slot />
</body>
</html>
