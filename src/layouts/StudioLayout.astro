---
import { site } from "@/data/site";
const themeCookie = Astro.cookies.get('theme');
const isDark = themeCookie?.value === 'dark';
const title = Astro.props.title ?? site.title;
const description = Astro.props.description ?? site.description;

import '/src/css/reset.css'
import '/src/css/theme.css'
import '/src/css/base.css'
import '/src/css/fonts.css'
---

<html lang="zh-CN" class={isDark ? 'dark' : ''}>
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url} />
    <!-- favicon 跟随系统深浅色 -->
    <link rel="icon" type="image/svg+xml"
          media="(prefers-color-scheme: dark)"
          href={site.logo.dark} id="favicon" />
    <link rel="icon" type="image/svg+xml"
          media="(prefers-color-scheme: light)"
          href={site.logo.light} />
    <script is:inline>
        // favicon 跟随系统深浅色实时切换
        // 路径与 site.logo.dark / site.logo.light 保持一致
        ;(function () {
            const mq = window.matchMedia('(prefers-color-scheme: dark)')
            const favicon = document.getElementById('favicon')
            if (!favicon) return
            const dark = '/wswd-white.svg'
            const light = '/wswd-black.svg'
            favicon.href = mq.matches ? dark : light
            mq.addEventListener('change', (e) => {
                favicon.href = e.matches ? dark : light
            })
        })()
    </script>

    <!-- OG -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" /><!--如果是文章用 article，视频用 video-->
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={site.url + site.logo.og} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- JSON-LD -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": site.name,
        "url": site.url,
        "logo": site.url + site.logo.og,
        "sameAs": site.social,
    })} />

    <slot name="head" />
    <style>
        /* ── 布局专属样式 ────────────── */
        html, body {
            block-size: 100dvb;
            inline-size: 100dvi;
            overflow: hidden;
            touch-action: pan-y;
            scrollbar-width: none;
        }
        body::-webkit-scrollbar {
            display: none;
        }

        /* 全屏翻页：所有 section 堆叠在视口内 */
        .snap-section {
            position: absolute;
            inset: 0;
        }
    </style>
</head>
<body>
<slot />
<script>
import { initPageAnimator } from '@/utils/pageAnimator'
initPageAnimator()
</script>
</body>
</html>
