---
import Header from '@/components/header/Header.astro'
import MaintenanceAbout from '@/components/maintenance/MaintenanceAbout.astro'
import MaintenanceHero from '@/components/maintenance/MaintenanceHero.astro'
import MaintenanceJoin from '@/components/maintenance/MaintenanceJoin.astro'
import MaintenanceServices from '@/components/maintenance/MaintenanceServices.astro'
import ScrollablePageLayout from '@/layouts/ScrollablePageLayout.astro'
import { maintenancePage } from '@/data/maintenance'
import '@/css/nonGlobal/studioColor.css'
import '@/css/nonGlobal/maintenance.css'
---

<ScrollablePageLayout title={maintenancePage.seo.title} description={maintenancePage.seo.description}>
    <Header />
    <main class="maintenance-page">
        <MaintenanceHero />
        <MaintenanceAbout />
        <MaintenanceServices />
        <MaintenanceJoin />
    </main>
</ScrollablePageLayout>

<script>
    document.documentElement.classList.add('js')

    const sections = document.querySelectorAll('.maintenance-section')
    if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) entry.target.classList.add('is-in-view')
            })
        }, { threshold: 0.12 })
        sections.forEach((section) => observer.observe(section))
    }
</script>
