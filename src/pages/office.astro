---
import { tmp } from "@/data/tmp";
import ScrollablePageLayout from "@/layouts/ScrollablePageLayout.astro";
import Header from "@/components/header/Header.astro";
import OfficeSectionNav from "@/components/office/OfficeSectionNav.astro";
import '/src/css/nonGlobal/studioColor.css'
---
<ScrollablePageLayout
        title={tmp.title}
        description={tmp.description}
>
    <Header canMove />
    <OfficeSectionNav />
    <main class="office-page">
        <section id="home" class="tmp">
            <span>监修中</span>
        </section>
    </main>
</ScrollablePageLayout>

<style>
    .office-page [id] {
        scroll-margin-block-start: calc(var(--office-section-nav-height) + 1rem);
    }

    .tmp{
        display: flex;
        align-items: center;
        justify-content: center;
        min-block-size: 100dvb;
        box-sizing: border-box;
    }
    .tmp span{
        font-family: Huiwen-HKHei, cursive;
        font-size: 7.5rem;
    }

    @media (max-width: 48rem) {
        .office-page {
            padding-block-start: calc(var(--office-masthead-height) + var(--office-section-nav-height));
        }

        .office-page [id] {
            scroll-margin-block-start: calc(
                var(--office-masthead-height) + var(--office-section-nav-height) + 1rem
            );
        }
    }
</style>
