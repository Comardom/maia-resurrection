---
import { studio } from "@/data/studio.ts";
import FullScreenPagingLayout from "@/layouts/FullScreenPagingLayout.astro";
import Header from "@/components/header/Header.astro";
import FullScreenPhoto from "@/components/studio/FullScreenPhoto.astro";
import Rainbow from "@/components/studio/Rainbow.astro";
import TimelinePlayer from "@/components/studio/TimelinePlayer.astro";
import Footer from "@/components/studio/Footer.astro";
import '/src/css/nonGlobal/studioColor.css'
import '/src/css/nonGlobal/studio.css'
---
<FullScreenPagingLayout
    title={studio.title}
    description={studio.description}
>
    <Header />
    <div class="snap-section" id="Prologue" data-section="1">
        <FullScreenPhoto />
    </div>
    <div class="snap-section" id="Symphony" data-section="2">
        <Rainbow />
    </div>
    <div class="snap-section" id="Timeline" data-section="3">
        <TimelinePlayer />
    </div>
    <div class="snap-section" id="Epilogue" data-section="4">
        <Footer />
    </div>
</FullScreenPagingLayout>