---
import Header from '@/components/header/Header.astro'
import VideoCapabilities from '@/components/video/VideoCapabilities.astro'
import VideoEpilogue from '@/components/video/VideoEpilogue.astro'
import VideoHero from '@/components/video/VideoHero.astro'
import VideoSectionNav from '@/components/video/VideoSectionNav.astro'
import { videoPage } from '@/data/video'
import FullScreenPagingLayout from '@/layouts/FullScreenPagingLayout.astro'

import '@/css/nonGlobal/studioColor.css'
import '@/css/nonGlobal/studio.css'
import '@/css/nonGlobal/videoColor.css'
import '@/css/nonGlobal/video.css'
---

<FullScreenPagingLayout
    title={videoPage.seo.title}
    description={videoPage.seo.description}
>
    <Header />
    <main class="video-page">
        <VideoHero />
        <VideoCapabilities />
        <VideoEpilogue />
    </main>
    <VideoSectionNav />
</FullScreenPagingLayout>
